# backend/.env
# =============================================
# Environment Variables for Secure Chat Application
# =============================================

# ----------------------------
# Flask Application Settings
# ----------------------------
FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=
PORT=5000

# ----------------------------
# Database Configuration
# ----------------------------
DATABASE_URL=mysql+pymysql://root@127.0.0.1/secure_chat_app
# For MySQL with password:
# DATABASE_URL=mysql+pymysql://username:password@localhost/secure_chat_app
# For PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost/secure_chat_app
# For SQLite (development):
# DATABASE_URL=sqlite:///secure_chat.db

DB_POOL_SIZE=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
SQL_ECHO=False

# ----------------------------
# JWT Authentication
# ----------------------------
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=1        # Hours
JWT_REFRESH_TOKEN_EXPIRES=30      # Days
JWT_COOKIE_SECURE=False           # Set to True in production
JWT_COOKIE_SAMESITE=Lax

# ----------------------------
# CORS Configuration
# ----------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000

# ----------------------------
# Rate Limiting
# ----------------------------
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_ENABLED=False
RATELIMIT_STORAGE_URL=memory://    # Use redis://localhost:6379 in production

# ----------------------------
# File Upload
# ----------------------------
MAX_CONTENT_LENGTH=104857600       # 100MB (in bytes)
UPLOAD_FOLDER=uploads

# ----------------------------
# Email Configuration (for verification)
# ----------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=

# ----------------------------
# Security Settings
# ----------------------------
BCRYPT_LOG_ROUNDS=12               # 12-14 for production
SESSION_COOKIE_SECURE=False        # Set to True in production
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=30      # Days

PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=15                    # Minutes

# ----------------------------
# Encryption Settings
# ----------------------------
RSA_KEY_SIZE=2048
AES_KEY_SIZE=32                    # 256 bits
PBKDF2_ITERATIONS=100000

# ----------------------------
# Cache Configuration
# ----------------------------
CACHE_TYPE=simple                  # Use redis in production
CACHE_DEFAULT_TIMEOUT=300          # 5 minutes

# ----------------------------
# Logging
# ----------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ----------------------------
# Redis Configuration (for production)
# ----------------------------
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=

# ----------------------------
# Application Settings
# ----------------------------
APP_NAME=Secure Chat Application
APP_VERSION=1.0.0
API_PREFIX=/api

# ----------------------------
# External Services (Optional)
# ----------------------------
# SENTRY_DSN=your-sentry-dsn-url
# PROMETHEUS_ENABLED=False

# ----------------------------
# Development Specific
# ----------------------------
# Flask Debug Toolbar
# DEBUG_TB_ENABLED=True
# DEBUG_TB_INTERCEPT_REDIRECTS=False

# SQLAlchemy
# SQLALCHEMY_ECHO=False

# =============================================
# IMPORTANT NOTES:
# =============================================
# 1. NEVER commit this file to version control!
# 2. Create .env file locally and keep it secure
# 3. For production, use strong, unique keys
# 4. Use .env.example as template for team members
# 5. Set DEBUG=False and JWT_COOKIE_SECURE=True in production
# =============================================