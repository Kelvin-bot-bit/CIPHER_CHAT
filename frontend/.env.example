# Base URL of the Flask backend for direct (non-proxied) requests.
# Leave blank to use the Vite dev proxy (/api, /socket.io) configured
# in vite.config.js, which is recommended for local development because
# it keeps requests same-site so auth cookies work without extra CORS setup.
VITE_API_BASE_URL=

# Origin the dev server proxies /api and /socket.io to.
VITE_BACKEND_ORIGIN=http://127.0.0.1:5000
